{
    "name": "buyunic/enrollment-portal",
    "description": "BUYUNIC Enrollment Portal - IT Training Registration System",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "BUYUNIC Team",
            "email": "info@buyunic.ug"
        }
    ],
    "require": {
        "php": ">=7.4",
        "phpmailer/phpmailer": "^6.8",
        "tecnickcom/tcpdf": "^6.6",
        "endroid/qr-code": "^4.8",
        "monolog/monolog": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "Buyunic\\": "classes/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "7.4"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "auto-scripts": {
            "cache:clear": "script"
        }
    }
}